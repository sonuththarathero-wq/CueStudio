    {
      "id": "b6ab1061-cc4f-4f04-b7d6-071903cb754e",
      "title": "කවි තාලය 1",
      "type": "chant",
      "cues": [
        {
          "id": "b57413bd-2793-4fde-b5a8-1d38020a2560",
          "text": "පිරුණු පා රමී බල ගෙ න සිත අදිටන් කො ට\nවැ ඩුණු විජය සිරිමහ බෝ වජිරා සන සිට\nවැ දුණු මා ර සේ නා බල සීලගුණෙ න් බට\nපිරිණු ඤා ණයෙන් බෝ සත් බුදුබව අත්කො ට\n",
          "performer": "Praveen , Yak Bera , Thalampata & Hak",
          "note": "",
          "duration": 47,
          "mode": "auto",
          "marker": 9,
          "upcomingColor": null
        },
        {
          "id": "f6ddc5d2-0fd5-4ce3-afda-a83a47d865f0",
          "text": "වැ ඩුණු සිතේ සමයෙ න් හිමි සක්වල ලෝ වට\nබැ ඳුණු පරම පිවිතුරු සිරි දම් කඳ එක් කො ට\nමැ කුණු වළා වෙ න් මිදෙ නා සඳ සෙ උදා කො ට\nබැ ඳුණු සත්වයන් සො යමින් කරුණාවෙ න් බට\n",
          "performer": "Praveen , Yak Bera , Thalampata & Hak",
          "note": "",
          "duration": 48,
          "mode": "auto",
          "marker": null,
          "upcomingColor": null
        },
        {
          "id": "5b56d6f7-ad9b-4311-9b2f-98dd61a54bc3",
          "text": "වැ ඩුණු පිනේ ගුණයෙන් පිරි මනු ලෝ සත්නට\nබැ ඳුණු යදම් වන් කෙ ලෙ සුන් සුන්කර නස්නට\nදිළුණු දහම් ෂඩ් රශ්මිය විහිදා ලෝ වට\nබැ ඳුණු සත්ත්වයන් පැ මිනෙ ති දම් පද අස්නට\n",
          "performer": "Praveen , Yak Bera , Thalampata & Hak",
          "note": "Next Beat Changes & Tempo +",
          "duration": 49,
          "mode": "auto",
          "marker": null,
          "upcomingColor": "#43A047"
        }
      ]
    },
    {
      "id": "1e014e34-cbc0-43c3-8f13-6c9e55e7f75b",
      "title": "කවි තාලය 2",
      "type": "custom",
      "cues": [
        {
          "id": "686466b8-5b8f-40bd-b84f-f59677b03b45",
          "text": "දිව්‍ය ධරණි අධිපති මහ සක්දෙ ව් රජ බැ ස\nසතර රජුන් වරම් ලබා සතර දො රටු සිට ආ....\n",
          "performer": "Praveen , Yak Bera , Thalampata & Hak",
          "note": "",
          "duration": 14.5,
          "mode": "auto",
          "marker": null,
          "upcomingColor": null
        },
        {
          "id": "a98c0fe7-3fd4-49f5-95cb-9e254b4903bc",
          "text": "දැ ඩිමුඩ දෙ වි සමග වඩින යක්ඛ පිරිස වට\nඅචල මෙ රුව සො ලවා ගෙ න නා රජවරු එන ආ....\n",
          "performer": "Praveen , Yak Bera , Thalampata & Hak",
          "note": "",
          "duration": 14.5,
          "mode": "auto",
          "marker": null,
          "upcomingColor": null
        },
        {
          "id": "9d20ff2f-416a-4bb6-8780-2152a26c4e6e",
          "text": "සාසන ගැ ති උරුම රකින අෂ්ටව බහිරව\nභූත යකුන් දමනය වී කරදිය රැස් වට ආ....\n",
          "performer": "Praveen , Yak Bera , Thalampata & Hak",
          "note": "",
          "duration": 14.5,
          "mode": "auto",
          "marker": null,
          "upcomingColor": "#43A047"
        },
        {
          "id": "2dd2d11b-c966-4196-bdd3-3f4e8c859e3b",
          "text": "භූමා ටුව පටන් විහිද සක්වල අනතක\nපිරිත අසන්නට රැස්වනු ආසිරි නිවනට ආ....\n",
          "performer": "Praveen , Yak Bera , Thalampata & Hak",
          "note": "",
          "duration": 14.5,
