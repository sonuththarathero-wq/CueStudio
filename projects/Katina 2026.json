{
  "title": "Katina 2026",
  "settings": {},
  "scripts": [
    {
      "id": "s",
      "title": "බුද්ධං සිවං සිරිධරං",
      "type": "custom",
      "cues": [
        {
          "id": "c",
          "text": "Hak & Drum Roll",
          "performer": "Everyone",
          "duration": 12,
          "mode": "auto",
          "marker": null,
          "note": "",
          "upcomingColor": null
        },
        {
          "id": "bf5946fd-1e83-4d65-8dc9-265df48868e1",
          "text": "බුද්ධං සිවං සිරිධරං - ගුරුසිද්ධ ලෝකං\nඤාණං ච සෙට්ඨ මනසං - මුණි ධම්ම රාජං\nසුද්ධං ච ධම්ම මධුරං - සරණං ති ලෝකං\nපූජේමි ජීවිතමහං - සහ භේරි සද්ධං\n",
          "performer": "Everyone",
          "note": "",
          "duration": 76,
          "mode": "auto",
          "marker": 1,
          "upcomingColor": null
        },
        {
          "id": "3ddc06eb-3e97-48f8-af5c-7f66fb56fce4",
          "text": "Yak Bera Roll & Hak",
          "performer": "Yak Bera 2 & Abeetha",
          "note": "",
          "duration": 8,
          "mode": "auto",
          "marker": null,
          "upcomingColor": "#E53935"
        },
        {
          "id": "ab7895d5-a4c5-4258-ac5f-08c8d716db3d",
          "text": "සක්වල දස දහසකට, කෝටි ලක්ෂයක් සක්වලට, අප ධර්ම රාජෝත්තම...\nඑදා දීපංකර මුණි පාමුල වැතිර, තම නිවන අතහැර...",
          "performer": "Praveen",
          "note": "In Between Yak Bera Plays in low sound",
          "duration": 16,
          "mode": "auto",
          "marker": null,
          "upcomingColor": "#43A047"
        },
        {
          "id": "c29f799c-a365-43c5-b19c-0e355afad0f3",
          "text": "යටින් අවීතියද, උඩින් භවාග්‍රයද, වටින් සක්වලද\nසියලු ලෝ සතුන් එතෙර කිරීමේ මහා අදිටනින්, නියත විවරණ ලැබ...\nචතුර සංඛ්‍ය කල්ප ලක්ෂයක්, මහා පාරමී දම් පුරනු වස්, සසර සයුරට පැන...\nකලෙක බඹෙක්ව සුරෙක්ව සක්විති රජෙක්ව, ලෝ සතට වෙදෙක්ව, පියෙක්ව...\nසකලවිධ සියලු සම්පත්, තණ පතක් සේ අතහැර,\nතවුසෙක්ව, මහණෙක්ව, වනයට වැද...\n",
          "performer": "Praveen",
          "note": "",
          "duration": 29,
          "mode": "auto",
          "marker": 2,
          "upcomingColor": null
        },
        {
          "id": "a782a185-b125-4463-8a7c-14fed23e2981",
          "text": "තවද ජාතීන්හී, මහා වඳුරු අත්බවයක, සා අත්බැවයක, මුව අත්බැවයක\nලේ මස් ජීවිත දන් දී, වටු අත්බැවයක සිට, සත්‍ය ක්‍රියා ආදී කොට...\nඅප්‍රමාණ අත් භවයන්හි, අප්‍රමාණ දුක් විඳ, අප්‍රමාණ වාරයක්, ජීවිත පූජා කොට\nගුණදම් පුරා පතුරවා, මහා මෙත් සිසිල් පතුරවා, දාන සීල භාවනා පෙරටු\nකොට...\n",
          "performer": "Praveen",
          "note": "",
          "duration": 22,
          "mode": "auto",
          "marker": null,
          "upcomingColor": null
        },
        {
          "id": "c469fe16-dedc-4f2b-b59c-ecff1e7a667f",
          "text": "පාරමී, උපපාරමී, පරමත්ථ පාරමී, සමතිස් පෙරුම්දම් බල නගා\nපශ්චිම අත්භවයට පැමිණ, ශ්‍රේෂ්ඨ සීහ නාද කොට...\nසා වසක් දුෂ්කර ක්‍රියා කොට, අවසන ජය ශ්‍රී විජය ශ්‍රී මහා බෝ මැඩ\nපුර්ණ චන්ද්‍ර කලා, සෞ ම්‍ය පසළොස්වක් පෝදා, මැදියම් රැයේ තනිව...\n",
          "performer": "Praveen",
          "note": "",
          "duration": 21,
          "mode": "auto",
          "marker": 3,
          "upcomingColor": null
        },
        {
          "id": "6a0d12a5-f879-4fac-b2d0-11ba002a1eff",
          "text": "දිව්‍ය මාර, පංච මාර, දස මාර, පරිවාර මාර සේනා\nතම දක්ඛිණ හස්තයේ අංගුලිකාවෙන්, පොළෝමහී කාන්තාව සපත කොට\nතම පාරමී සත්‍යයක් ක්‍රියා බලයෙන් පරදවා...\nමහ පොළොව ගුගුරුවා, පුපුරවා, මහමෙර සසල කොට, සයුර නිසල කොට...\n",
          "performer": "Praveen",
          "note": "",
          "duration": 15,
          "mode": "auto",
          "marker": null,
          "upcomingColor": null
        },
        {
          "id": "95952150-574f-4af1-8ee5-5257d6ddb2a4",
          "text": "වින බන්ධන, හිර බන්ධන, යන්ත්‍ර මන්ත්‍ර හිර වැළැක්කුං, ඉගිල පිපිර කපාල\nඡේදන කොට\nලෝක ධාතු, විශ්ව ධාතු, සක්වල ධාතු, කම්පා කොට...\nඅෂ්ට සමාපත්ති බල පරදවා, අනන්ත සක්වලට සවනක් ගණ රශ්මිමාලා වන්\nවිහිදුවා පතුරවා...\n",
          "performer": "Praveen",
          "note": "",
          "duration": 18,
          "mode": "auto",
          "marker": null,
          "upcomingColor": null
        },
        {
          "id": "dfef9ff4-ce9f-436c-8354-19191fabaf51",
          "text": "සර්වඥ පද ප්‍රාප්ත ව, ෂඩ් අසාධාරණ ඥාන උපදවා...\nඅප මහා නර සීහයාණෝ, සම්මා සම්බුද්ධ රාජ්‍යය උරුම කරගත් සේක...\n",
          "performer": "Praveen",
          "note": "",
          "duration": 12,
          "mode": "auto",
          "marker": null,
          "upcomingColor": null
        },
        {
          "id": "06fafdec-849f-4d86-a4b1-631852a87417",
          "text": "Yak Bera Roll & Hak",
          "performer": "Hak & Yak Bera 2",
          "note": "",
          "duration": 9,
          "mode": "auto",
          "marker": 4,
          "upcomingColor": "#E53935"
        },
        {
          "id": "7fe089cc-1ab5-45c4-9849-65a906e8c6cc",
          "text": "මගේ බුදු අප්පොච්චි, එතැන් පටන් විශ්වයට සම වැද...\nසතර සතිපට්ඨානයෝය, සතර සම්‍යක් ප්‍රදානයෝය,\nසතර ඉර්දිපාදයෝය, පංචේන්ද්‍රීයෝය, පංච බලයෝය...\nසප්ත බොජ්ජංගයෝය, ආර්ය අෂ්ඨාං ගික මාර්ගයෝය,\n",
          "performer": "Praveen",
          "note": "",
          "duration": 16,
          "mode": "auto",
          "marker": null,
          "upcomingColor": null
        },
        {
          "id": "7e14d61b-5d4a-4e73-9c56-0f97fc6bf61c",
          "text": "ආදී කොට ඇති විශ්වයේ සත්‍ය අස්සක් මුල්ලක් නෑර, අවබෝධ කොට...\nඅමා දම් බල නගා, කන් කලු වූ, ශ්‍රී මුඛ පද්මය විවරකොට, සද්ධර්ම චක්‍රය\nප්‍රවර්තනය කොට...\nදහම් සකේ ආශ්චර්‍යය, ලෝක ධාතු පරදවා, සක්වළ ගල පරදවා, කෝටි ලක්ෂයක්\nසක්වල,\nසූ විසි අසංඛය සත්ත්ව සමූහයාගේ, සිත් සුවපත් කල බව සත්‍ය යි...\n",
          "performer": "Praveen",
          "note": "",
          "duration": 17,
          "mode": "auto",
          "marker": null,
          "upcomingColor": null
        },
        {
          "id": "242e0b48-42da-44ac-94f2-8f1bd1398096",
          "text": "එම ආශ්චර්‍ය, අප දෙනෙතට නොපෙනෙන, දිවැසට පෙනෙන, දෙව් බඹුන් සාක්ෂි\nදරන්නේමය...\n",
          "performer": "Praveen",
          "note": "",
          "duration": 8.5,
          "mode": "auto",
          "marker": 5,
          "upcomingColor": null
        },
        {
          "id": "6c5b90bf-f27f-4ccf-b138-53efe8cbec64",
          "text": "ධර්මයේ ආනුභාවය කෙසේදයත්,\nඑදා මධ්‍යම රාත්‍රි යාමයේ, මුලු අහස් කුස ඒකලෝක කොට...\nජේතවනයට සකල දෙව් බඹුන් වැඩියා මෙන්, අදද මේ ජේතවනයට, මේ උතුම්\nභූමියට, මේ පිරිත් ශ්‍රවණයට, ඔවුන් රැස් වෙනවා සත්‍යමයි, ආයු බෝ....\n",
          "performer": "Praveen",
          "note": "",
          "duration": 19,
          "mode": "auto",
          "marker": 6,
          "upcomingColor": null
        },
        {
          "id": "5cb8efc8-cc2c-4011-a31c-33168fd08bb0",
          "text": "මෙතැන් පටන් කෙරෙන්නා වූ ශ්‍රී මුඛ බුද්ධ දේශනාවේ, ආඤ්ඤාව ආනුභාවය\nකෙසේදයත්,\nමේ භූමියේ පටන් වන්නා වූ, ගම් දන්ව් සිසාරා, රටේ ලෝකයේ...\nලෝක ධාතූන් හි, සක්වල ධාතූන් හි, අසංඛය අප්‍රමේය වූ, සියලු ලෝක සකල\nසත්ත්වයන්ගේ...\n",
          "performer": "Praveen",
          "note": "",
          "duration": 14,
          "mode": "auto",
          "marker": null,
          "upcomingColor": null
        },
        {
          "id": "5617c091-33a4-4712-8183-cc94a980db44",
          "text": "අඳුර දුරලා, වින නසා, හිර නසා, පව් නසා, සකල රෝගපීඩා දුරු කරවා...\nසබ්බ බන්ධන උගුලුවා,භංග කරවා, කල එලි වී ආලෝක වී...\nගුණ පුරා, පින් පුරා, සුවපත්ව, අමා නම් වූ නිවන ලැබ,\nසුවපත් වන්නට ආසිරි... ආ...\n",
